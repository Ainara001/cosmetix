# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# Without any key the proxy runs in MOCK mode: every answer is clearly marked
# as a test answer and nothing is sent to an AI provider.

# Pick ONE provider (or set AI_PROVIDER=gemini|claude to force it).
# Gemini: key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Claude: key from https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
AI_PROVIDER=

PORT=8787
# 0.0.0.0 (default) lets a real iPhone on your Wi-Fi connect; 127.0.0.1 = this Mac only
HOST=
# Optional shared token: when set, the app must send it in the x-app-token header.
APP_TOKEN=
# Limits (defaults shown)
MAX_OUTPUT_TOKENS=600
RATE_LIMIT_PER_MIN=20
DAILY_TOKEN_BUDGET=200000
UPSTREAM_TIMEOUT_MS=45000
