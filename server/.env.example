# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# Without any key the proxy runs in MOCK mode: every answer is clearly marked
# as a test answer and nothing is sent to an AI provider.

# Pick ONE provider (or set AI_PROVIDER=gemini|claude to force it).
# Gemini: key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Claude: key from https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
AI_PROVIDER=

# PostgreSQL for the catalog / profile API and the admin panel. Without it only
# /health and /v1/chat work. Example: postgres://user:password@localhost:5432/cosmetix
DATABASE_URL=
# 1 = the connection to PostgreSQL uses TLS (hosted databases)
PG_SSL=
# The admin panel works only on this machine unless you set all three, and only
# behind a reverse proxy that terminates HTTPS (see README, "Admin panel"):
# 1 = the admin cookie gets the Secure flag
ADMIN_COOKIE_SECURE=
# 1 = the panel may be opened from other addresses (the connection is plain HTTP)
ADMIN_ALLOW_REMOTE=
# host names the panel answers to, comma separated, e.g. admin.example.com
ADMIN_ALLOWED_HOSTS=
# database timeouts in milliseconds (defaults shown)
PG_CONNECT_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=10000
# 0 = do not apply new migrations on start (run `npm run migrate` yourself)
AUTO_MIGRATE=

PORT=8787
# 0.0.0.0 (default) lets a real iPhone on your Wi-Fi connect; 127.0.0.1 = this Mac only
HOST=
# Optional shared token: when set, the app must send it in the x-app-token header.
APP_TOKEN=
# Limits (defaults shown)
MAX_OUTPUT_TOKENS=600
RATE_LIMIT_PER_MIN=20
DAILY_TOKEN_BUDGET=200000
UPSTREAM_TIMEOUT_MS=45000
